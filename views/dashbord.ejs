<!DOCTYPE html>
<html lang="pt">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Área de Administração</title>
    <link rel="stylesheet" href="/style.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <link rel="stylesheet" href="/css/dashbord.css">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>


</head>

<body>
    <!-- Layout -->
    <div class="admin-layout">
        <!-- Sidebar -->
        <%- include('./partials/sidebar.ejs', { admin }) %>

            <!-- Main Content -->
            <main class="main-content">
                <!-- Header -->
                <header class="header">
                    <div class="header-text">
                        <h1>Dashboard</h1>
                        <p>Olá <%= admin.nome %>
                        </p>
                    </div>
                    <div class="user-header">
                        <div class="notification-wrapper">
                            <i class="fas fa-bell" id="notification-bell"></i>
                            <span class="notification-count" id="notification-count">0</span>
                            <div class="notification-dropdown" id="notification-dropdown">
                                <ul id="notification-list"></ul>
                            </div>
                        </div>
                        <img src="<%= admin.foto || '/Imagem/default-profile.jpg' %>" alt="Foto de perfil">
                        <span>
                            <%= admin.nome %>
                        </span>
                    </div>
                </header>

                <!-- Dashboard Cards -->
                <div class="dashboard-cards">
                    <a href="/cursos" class="dashboard-card-link" title="Gerir cursos">
                        <div class="card" id="cursos-card">
                            <div class="card-icon">
                                <i class="fas fa-graduation-cap"></i>
                            </div>
                            <h3>CURSOS PUBLICADOS</h3>
                            <p class="number" id="cursos-count">⋯</p>
                        </div>
                    </a>

                    <a href="/artigos" class="dashboard-card-link" title="Gerir artigos">
                        <div class="card active" id="artigos-card">
                            <div class="card-icon">
                                <i class="fas fa-file-alt"></i>
                            </div>
                            <h3>ARTIGOS PUBLICADOS</h3>
                            <p class="number" id="artigos-count">⋯</p>
                        </div>
                    </a>

                    <a href="/admin/usuarios" class="dashboard-card-link" title="Ver inscritos">
                        <div class="card" id="inscritos-card">
                            <div class="card-icon">
                                <i class="fas fa-users"></i>
                            </div>
                            <h3>INSCRITOS</h3>
                            <p class="number" id="inscritos-count">⋯</p>
                        </div>
                    </a>
                </div>
                <section class="dashboard-charts">
                    <h2>Gráficos</h2>
                    <div class="charts-container">
                        <canvas id="cursosChart"></canvas>
                        <canvas id="artigosChart"></canvas>
                        <canvas id="inscritosChart"></canvas>
                    </div>
                </section>


                <!-- 🔹 Nova seção estática -->
                <section class="secao-estatica">
                    <h2>Comentários</h2>
                    <div class="comentarios-container" id="comentarios-container">
                        <!-- Comentários carregados via JS -->
                    </div>
                </section>
            </main>
    </div>

    <script src="/js/navbar.js"></script>
    <script src="/js/dashboard.js"></script>
</body>

</html>